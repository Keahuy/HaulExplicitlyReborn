<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <OutputPath>..\..\1.7\Assemblies\</OutputPath>
      <Optimize>true</Optimize>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <OutputPath>..\..\1.7\Assemblies\</OutputPath>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Lib.Harmony.Ref" Version="2.4.3" />
    </ItemGroup>

    <ItemGroup>
      <Reference Include="Assembly-CSharp">
        <HintPath>..\..\..\..\Assembly-CSharp.dll</HintPath>
        <Private>False</Private>
      </Reference>
      <Reference Include="UnityStubs">
        <HintPath>..\..\..\..\UnityStubs.dll</HintPath>
        <Private>False</Private>
      </Reference>
      <Reference Include="Waylith">
        <HintPath>..\..\..\..\Waylith.dll</HintPath>
        <Private>False</Private>
      </Reference>
    </ItemGroup>

</Project>
